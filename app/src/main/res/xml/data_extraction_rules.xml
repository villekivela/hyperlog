<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup on Android 12 and later (docs/backups.md). Everything the user made lives in
  the Room database (hyperlog.db with its -wal and -shm files), so that is what goes to the Google
  account and to a new phone in a device-to-device transfer. The Claude key lives in no_backup,
  which Android never backs up or transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
